ARG DOTNET_VERSION=10.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
WORKDIR /source

COPY src/Encoding.NodeAgent/Encoding.NodeAgent.csproj ./src/Encoding.NodeAgent/
COPY src/Encoding.Contracts/Encoding.Contracts.csproj ./src/Encoding.Contracts/
COPY src/Encoding.Core/Encoding.Core.csproj ./src/Encoding.Core/
RUN dotnet restore ./src/Encoding.NodeAgent/Encoding.NodeAgent.csproj
COPY src/Encoding.NodeAgent ./src/Encoding.NodeAgent
COPY src/Encoding.Contracts ./src/Encoding.Contracts
COPY src/Encoding.Core ./src/Encoding.Core
RUN dotnet publish ./src/Encoding.NodeAgent/Encoding.NodeAgent.csproj --configuration Release --output /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION} AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg mkvtoolnix mediainfo imagemagick nodejs python3 && rm -rf /var/lib/apt/lists/*
# Plugins d'intégration livrés avec le worker (processus Python séparés, voir backend/plugins/README.md).
# Le manifeste copié est le JSON que le serveur charge : une seule définition des composants.
COPY plugins/sdk/encoding_plugin_sdk.py plugins/arr/plugin.py /opt/encoding/plugins/arr/
COPY src/Encoding.Api/Flows/Catalog/sonarr.json src/Encoding.Api/Flows/Catalog/radarr.json /opt/encoding/plugins/arr/manifests/
COPY plugins/sdk/encoding_plugin_sdk.py plugins/plex/plugin.py /opt/encoding/plugins/plex/
COPY src/Encoding.Api/Flows/Catalog/plex.json /opt/encoding/plugins/plex/manifests/
COPY plugins/sdk/encoding_plugin_sdk.py plugins/jellyfin/plugin.py /opt/encoding/plugins/jellyfin/
COPY src/Encoding.Api/Flows/Catalog/jellyfin.json /opt/encoding/plugins/jellyfin/manifests/
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8081
ENTRYPOINT ["dotnet", "Encoding.NodeAgent.dll"]
