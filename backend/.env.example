# Configuration du worker local de développement. Le fichier .env est ignoré par Git.
NODE_NAME=encoding-dev-node
NODE_ROLES=worker
NODE_MAX_CONCURRENT_TASKS=1
WORKER_AUTO_ACCEPT_ENROLLMENT=false
# Pour des workers hors de ce réseau Compose, annoncer une URL API joignable depuis ces machines.
CLUSTER_ADVERTISED_API_BASE_URL=http://api:8080/
# URL API joignable depuis les autres serveurs pour le maillage (utile hors du même réseau mDNS).
CLUSTER_RECONCILIATION_ADVERTISED_API_BASE_URL=
# Adresse locale à laquelle Docker publie l'API pour les pairs ; conserve la boucle locale par défaut.
CLUSTER_API_BIND_ADDRESS=127.0.0.1
# Si mDNS ne traverse pas le réseau, adresse d'un autre serveur API (à configurer en sens inverse sur le pair).
CLUSTER_RECONCILIATION_PEER_0=
# Si défini, exigé pour créer le premier administrateur depuis l’interface.
AUTH_SETUP_TOKEN=
# Mode pair à pair optionnel ; voir docs/operations/peer-cluster-preview.md.
PEER_CLUSTER_ENABLED=false
PEER_CLUSTER_ID=
PEER_CLUSTER_BOOTSTRAP=false
PEER_CLUSTER_PUBLIC_ENDPOINT=
PEER_CLUSTER_IDENTITY_PASSWORD=
# Clé commune générée une fois avec openssl rand -base64 32 ; ne pas versionner la valeur.
PEER_CLUSTER_SHARED_DATA_KEY=
PEER_CLUSTER_BIND=127.0.0.1:8443
