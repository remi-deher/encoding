# Configuration du worker local de développement. Le fichier .env est ignoré par Git.
NODE_NAME=encoding-dev-node
NODE_ROLES=worker
NODE_MAX_CONCURRENT_TASKS=1
WORKER_UI_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4201,http://127.0.0.1:4201,http://localhost:5080,http://127.0.0.1:5080
WORKER_AUTO_ACCEPT_ENROLLMENT=false
# Pour des workers hors de ce réseau Compose, annoncer une URL API joignable depuis ces machines.
CLUSTER_ADVERTISED_API_BASE_URL=http://api:8080/
# Si défini, exigé pour créer le premier administrateur depuis l’interface.
AUTH_SETUP_TOKEN=
