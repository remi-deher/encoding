    {
      "id": "base-publish-result",
      "version": "1.8.0",
      "name": "Publier le résultat",
      "description": "Publie le résultat du traitement dans la bibliothèque maintenant, au lieu d’attendre la fin du flow, puis continue : les blocs suivants (Plex, Radarr, Sonarr, scripts…) s’exécutent une fois le média en place. Se place après « Exécuter le traitement ». Publication sans écrasement, ou remplacement de la source si la bibliothèque a activé sa politique de remplacement ; la garde de publication (lecture Plex) s’applique comme à la fin d’un flow. Sans ce bloc, le flow publie à sa fin, comme avant. Un échec d’un bloc suivant ne défait pas la publication.",
      "kind": "action",
      "mediaType": "general",
      "supportedFlowMediaTypes": [
        "video",
        "image",
        "music",
        "subtitles"
      ],
      "outputs": [
        {
          "id": "published",
          "label": "Publié",
          "description": "Le résultat est en place dans la bibliothèque ; le flow continue."
        },
        {
          "id": "unchanged",
          "label": "Rien à publier",
          "description": "Le média n’a pas été modifié par le flow : aucune publication."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "La publication n’a pas pu être demandée (plan non exécuté, résultat déjà publié)."
        }
