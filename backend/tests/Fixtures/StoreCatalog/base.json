    {
      "id": "base-script",
      "version": "1.0.0",
      "name": "Exécuter un script",
      "description": "Prépare les variables et les règles du flow ; les métadonnées sont disponibles après analyse.",
      "kind": "script",
      "mediaType": "general",
      "supportedFlowMediaTypes": [
        "video",
        "image",
        "music",
        "subtitles"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "Continuer sur ce chemin."
