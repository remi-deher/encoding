    {
      "id": "base-wait",
      "version": "1.1.0",
      "name": "Attendre",
      "description": "Met le flow en attente sans occuper de worker, puis reprend à l’étape suivante quand la condition est remplie. Le média reste réservé. Sans sortie « Délai dépassé » reliée, un délai dépassé fait échouer l’exécution.",
      "kind": "action",
      "mediaType": "general",
      "supportedFlowMediaTypes": [
        "video",
        "image",
        "music",
        "subtitles"
      ],
      "outputs": [
        {
          "id": "resumed",
          "label": "Reprise",
          "description": "La condition est remplie ; le flow continue."
        },
        {
          "id": "timeout",
          "label": "Délai dépassé",
          "description": "Le délai maximal est atteint. Si cette sortie n’est pas reliée, l’exécution échoue."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "mode",
            "label": "Reprendre quand",
            "type": "select",
            "defaultValue": "timer",
            "options": [
              {
                "value": "timer",
                "label": "Un délai est écoulé"
              },
              {
                "value": "nodeState",
                "label": "Un worker change d’état"
              },
              {
                "value": "workload",
                "label": "La charge de travail passe un seuil"
              },
              {
                "value": "block",
                "label": "Une condition de plugin est remplie"
              }
            ],
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "delayMinutes",
            "label": "Délai (minutes)",
            "type": "number",
            "description": "Mode « délai ».",
            "defaultValue": 30,
            "min": 1,
            "max": 10080,
            "importance": "basic",
            "section": "Paramètres",
            "visibleWhenFieldId": "mode",
            "visibleWhenValue": "timer"
          },
          {
            "id": "nodeId",
            "label": "Identifiant du worker",
            "type": "text",
            "description": "Mode « worker ». Vide : n’importe quel worker (obligatoire pour « hors ligne »).",
            "importance": "basic",
            "section": "Paramètres",
            "visibleWhenFieldId": "mode",
            "visibleWhenValue": "nodeState",
            "editor": "node"
          },
          {
            "id": "nodeStatus",
            "label": "État attendu du worker",
            "type": "select",
            "defaultValue": "online",
            "options": [
              {
                "value": "online",
                "label": "En ligne"
              },
              {
                "value": "offline",
                "label": "Hors ligne"
              },
              {
                "value": "idle",
                "label": "Libre (capacité disponible)"
              }
            ],
            "importance": "basic",
            "section": "Paramètres",
            "visibleWhenFieldId": "mode",
            "visibleWhenValue": "nodeState"
          },
          {
            "id": "workloadMetric",
            "label": "Mesure",
            "type": "select",
            "defaultValue": "running",
            "options": [
              {
                "value": "running",
                "label": "Tâches en cours"
              },
              {
                "value": "queued",
                "label": "Tâches en file"
              }
            ],
            "importance": "basic",
            "section": "Paramètres",
            "visibleWhenFieldId": "mode",
            "visibleWhenValue": "workload"
          },
          {
            "id": "workloadScope",
            "label": "Portée",
            "type": "select",
            "defaultValue": "cluster",
            "options": [
              {
                "value": "cluster",
                "label": "Tout le cluster"
              },
              {
                "value": "library",
                "label": "Bibliothèque du fichier"
              }
            ],
            "importance": "basic",
            "section": "Paramètres",
            "visibleWhenFieldId": "mode",
            "visibleWhenValue": "workload"
          },
          {
            "id": "workloadOperator",
            "label": "Comparaison",
            "type": "select",
            "defaultValue": "lte",
            "options": [
              {
                "value": "lte",
                "label": "Inférieur ou égal au seuil"
              },
              {
                "value": "gte",
                "label": "Supérieur ou égal au seuil"
              }
            ],
            "importance": "basic",
            "section": "Paramètres",
            "visibleWhenFieldId": "mode",
            "visibleWhenValue": "workload"
          },
          {
            "id": "workloadThreshold",
            "label": "Seuil",
            "type": "number",
            "description": "Mode « charge de travail ».",
            "defaultValue": 0,
            "min": 0,
            "max": 100000,
            "importance": "basic",
            "section": "Paramètres",
            "visibleWhenFieldId": "mode",
            "visibleWhenValue": "workload"
          },
          {
            "id": "blockNodeId",
            "label": "Bloc à surveiller",
            "type": "text",
            "description": "Mode « condition ». Identifiant d’une condition de plugin du flow (par exemple « Lecture en cours »). Elle est réévaluée par un worker éligible.",
            "importance": "basic",
            "section": "Paramètres",
            "visibleWhenFieldId": "mode",
            "visibleWhenValue": "block",
            "editor": "flow-node"
          },
          {
            "id": "blockOutputs",
            "label": "Sorties qui valent « remplie »",
            "type": "text",
            "description": "Mode « condition ». Sorties du bloc séparées par des virgules, par exemple idle.",
            "importance": "basic",
            "section": "Paramètres",
            "visibleWhenFieldId": "mode",
            "visibleWhenValue": "block"
          },
          {
            "id": "pollSeconds",
            "label": "Intervalle de vérification (secondes)",
            "type": "number",
            "description": "Fréquence de réévaluation des conditions autres qu’un délai.",
            "defaultValue": 60,
            "min": 15,
            "max": 3600,
            "importance": "advanced",
            "section": "Exécution"
          },
          {
            "id": "maxWaitMinutes",
            "label": "Attente maximale (minutes)",
            "type": "number",
            "description": "Vide : attente illimitée.",
            "min": 1,
            "max": 43200,
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "mediaPolicy",
            "label": "Média pendant l’attente",
            "type": "select",
            "defaultValue": "keep",
            "options": [
              {
                "value": "keep",
                "label": "Suivre la politique de la bibliothèque"
              },
              {
                "value": "beside",
                "label": "Créer une copie à côté (source jamais remplacée)"
              },
              {
                "value": "overwrite",
                "label": "Écraser le média en cours (si la bibliothèque l’autorise)"
              }
            ],
            "description": "Le média reste réservé pendant l’attente. Le choix s’applique à la publication du résultat : l’écrasement passe par la politique de remplacement de la bibliothèque (sauvegarde, période de grâce). Réglage historique : privilégiez la politique de bibliothèque.",
            "importance": "advanced",
            "section": "Compatibilité : publication",
            "legacyOnly": true
          }
        ]
      },
