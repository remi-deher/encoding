        {
          "id": "skipped",
          "label": "Ignoré",
          "description": "Aucun traitement nécessaire."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "Traiter l’échec de cette étape."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "scriptReference",
            "label": "Script de la bibliothèque",
            "type": "script-reference",
            "description": "Choisissez une version publiée. Son code est copié dans le flow et reste figé avec sa version.",
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "language",
            "label": "Langage",
            "type": "select",
            "defaultValue": "javascript",
            "options": [
              {
                "value": "javascript",
                "label": "JavaScript"
              },
              {
                "value": "python",
                "label": "Python"
              }
            ],
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "code",
            "label": "Code du script",
            "type": "text",
            "multiline": true,
            "required": true,
            "description": "Le script disposera du contexte média et des services du moteur. Son exécution attend le contrat des scripts.",
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "timeoutSeconds",
            "label": "Durée maximale (secondes)",
            "type": "number",
            "defaultValue": 60,
            "min": 1,
            "max": 86400,
            "importance": "advanced",
            "section": "Exécution"
          },
          {
            "id": "useTools",
            "label": "Outils média (tools)",
            "type": "boolean",
            "defaultValue": false,
            "description": "Ajoute l’aide tools au script : tools.run('ffmpeg', [...]) lance ffmpeg, ffprobe, mkvmerge, mkvextract, mkvpropedit, mediainfo ou magick dans le dossier de travail isolé du script. Exige un worker qui annonce script-tools.",
            "importance": "basic",
            "section": "Paramètres"
          }
        ]
      },
