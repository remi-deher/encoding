{
  "contractVersion": 1,
  "id": "ai",
  "version": "1.0.0",
  "name": "Intelligence Artificielle",
  "supportedHostContractVersions": [
    1
  ],
  "components": [
    {
      "id": "ai-translate-subtitles",
      "version": "1.0.0",
      "name": "Traduction de sous-titres (IA)",
      "description": "Traduit les sous-titres d'une langue vers une autre à l'aide d'une IA (Codex CLI, Claude CLI, Ollama ou API) en préservant strictement les minutages et styles.",
      "kind": "action",
      "mediaType": "subtitles",
      "supportedFlowMediaTypes": [
        "video",
        "subtitles"
      ],
      "outputs": [
        {
          "id": "output",
          "label": "Succès",
          "description": "Les sous-titres ont été traduits avec succès."
        },
        {
          "id": "rateLimit",
          "label": "Quota dépassé",
          "description": "Limite d'appels ou quota d'abonnement temporairement atteint."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "Erreur lors de la traduction ou de l'analyse des sous-titres."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "targetLanguage",
            "label": "Langue cible",
            "type": "text",
            "required": true,
            "inline": true,
            "defaultValue": "fr",
            "description": "Code de langue ISO-639 ou nom complet de la langue cible."
          },
          {
            "id": "sourceLanguage",
            "label": "Langue source",
            "type": "text",
            "required": false,
            "inline": true,
            "defaultValue": "auto",
            "description": "Langue source d'origine ou 'auto' pour détection automatique."
          },
          {
            "id": "provider",
            "label": "Fournisseur IA",
            "type": "select",
            "required": true,
            "defaultValue": "codex-cli",
            "options": [
              {
                "value": "codex-cli",
                "label": "OpenAI Codex CLI (Compte ChatGPT)"
              },
              {
                "value": "claude-cli",
                "label": "Anthropic Claude CLI (Compte Claude)"
              },
              {
                "value": "ollama",
                "label": "Ollama local"
              },
              {
                "value": "openai",
                "label": "API OpenAI / Cloud"
              }
            ]
          },
          {
            "id": "batchSize",
            "label": "Taille des lots (répliques)",
            "type": "number",
            "defaultValue": 80,
            "min": 20,
            "max": 200,
            "step": 10,
            "description": "Nombre de répliques envoyées par requête à l'IA."
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": true,
      "requiresWriteAccess": true,
      "compatiblePluginVersions": []
    },
    {
      "id": "ai-metadata-enricher",
      "version": "1.0.0",
      "name": "Enrichissement métadonnées (IA)",
      "description": "Génère des résumés contextuels, mots-clés ou chapitrage intelligent à partir des pistes et dialogues.",
      "kind": "action",
      "mediaType": "general",
      "supportedFlowMediaTypes": [
        "video",
        "audio"
      ],
      "outputs": [
        {
          "id": "output",
          "label": "Succès",
          "description": "Les métadonnées ont été enrichies."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "Erreur lors de l'analyse IA."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "task",
            "label": "Tâche",
            "type": "select",
            "required": true,
            "defaultValue": "summary",
            "options": [
              {
                "value": "summary",
                "label": "Générer un synopsis résumé"
              },
              {
                "value": "tags",
                "label": "Générer des mots-clés thématiques"
              },
              {
                "value": "chapters",
                "label": "Nommer les chapitres intelligemment"
              }
            ]
          },
          {
            "id": "provider",
            "label": "Fournisseur IA",
            "type": "select",
            "required": true,
            "defaultValue": "codex-cli",
            "options": [
              {
                "value": "codex-cli",
                "label": "OpenAI Codex CLI (Compte ChatGPT)"
              },
              {
                "value": "claude-cli",
                "label": "Anthropic Claude CLI (Compte Claude)"
              },
              {
                "value": "ollama",
                "label": "Ollama local"
              },
              {
                "value": "openai",
                "label": "API OpenAI / Cloud"
              }
            ]
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": true,
      "requiresWriteAccess": false,
      "compatiblePluginVersions": []
    }
  ],
  "configurationSchema": {
    "version": 1,
    "fields": [
      {
        "id": "defaultProvider",
        "type": "select",
        "label": "Fournisseur IA par défaut",
        "description": "Moteur utilisé pour l’inférence et la traduction.",
        "defaultValue": "ollama",
        "options": [
          {
            "value": "ollama",
            "label": "Ollama local"
          },
          {
            "value": "openai",
            "label": "OpenAI / Compatible API"
          },
          {
            "value": "codex-cli",
            "label": "OpenAI Codex CLI"
          },
          {
            "value": "claude-cli",
            "label": "Anthropic Claude CLI"
          }
        ]
      },
      {
        "id": "ollamaUrl",
        "type": "text",
        "label": "URL du serveur Ollama",
        "description": "Point d’accès Ollama local ou distant.",
        "defaultValue": "http://localhost:11434"
      },
      {
        "id": "ollamaModel",
        "type": "text",
        "label": "Nom du modèle Ollama",
        "description": "Modèle utilisé par défaut.",
        "defaultValue": "llama3:latest"
      }
    ]
  }
}
