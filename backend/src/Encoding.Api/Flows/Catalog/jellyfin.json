{
  "contractVersion": 1,
  "id": "jellyfin",
  "version": "1.0.0",
  "name": "Jellyfin",
  "supportedHostContractVersions": [
    1
  ],
  "configurationSchema": {
    "version": 1,
    "fields": [
      {
        "id": "baseUrl",
        "type": "text",
        "label": "Adresse du serveur",
        "required": true,
        "placeholder": "http://jellyfin:8096"
      },
      {
        "id": "apiKey",
        "type": "secret",
        "label": "Clé API Jellyfin",
        "required": true
      }
    ]
  },
  "components": [
    {
      "id": "jellyfin-refresh-item",
      "version": "1.0.0",
      "name": "Actualiser les métadonnées Jellyfin",
      "description": "Demande à Jellyfin d’actualiser les métadonnées de l’élément ciblé.",
      "kind": "action",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "Le composant a terminé son traitement."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "Le composant n’a pas pu terminer son traitement."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "itemId",
            "type": "text",
            "label": "ID de l’élément Jellyfin",
            "required": true,
            "placeholder": "Identifiant de l’élément"
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": false,
      "requiresWriteAccess": false
    },
    {
      "id": "jellyfin-refresh-library",
      "version": "1.0.0",
      "name": "Actualiser la bibliothèque Jellyfin",
      "description": "Demande à Jellyfin de rescanner ses bibliothèques.",
      "kind": "action",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "Le composant a terminé son traitement."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "Le composant n’a pas pu terminer son traitement."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": []
      },
      "requiredTools": [],
      "requiresMedia": false,
      "requiresWriteAccess": false
    },
    {
      "id": "jellyfin-check-item-indexed",
      "version": "1.0.0",
      "name": "Vérifier l’élément dans Jellyfin",
      "description": "Vérifie si Jellyfin connaît l’élément ciblé.",
      "kind": "condition",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "found",
          "label": "Trouvé",
          "description": "L’élément est présent dans la bibliothèque."
        },
        {
          "id": "notFound",
          "label": "Absent",
          "description": "L’élément n’est pas présent dans la bibliothèque."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "La vérification n’a pas pu aboutir."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "itemId",
            "type": "text",
            "label": "ID de l’élément Jellyfin",
            "required": true,
            "placeholder": "Identifiant de l’élément"
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": false,
      "requiresWriteAccess": false
    }
  ]
}
