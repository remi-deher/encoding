{
  "contractVersion": 1,
  "id": "plex",
  "version": "1.0.0",
  "name": "Plex",
  "supportedHostContractVersions": [
    1
  ],
  "configurationSchema": {
    "version": 1,
    "fields": [
      {
        "id": "baseUrl",
        "type": "text",
        "label": "Adresse du serveur",
        "required": true,
        "placeholder": "http://plex:32400"
      },
      {
        "id": "apiKey",
        "type": "secret",
        "label": "Jeton Plex",
        "required": true
      }
    ]
  },
  "components": [
    {
      "id": "plex-refresh-library",
      "version": "1.0.0",
      "name": "Actualiser la bibliothèque Plex",
      "description": "Demande à Plex d’actualiser les éléments traités.",
      "kind": "action",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "Le composant a terminé son traitement."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "Le composant n’a pas pu terminer son traitement."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "sectionId",
            "type": "number",
            "label": "ID de bibliothèque",
            "required": false,
            "description": "Laisser vide pour actualiser toutes les bibliothèques.",
            "min": 1,
            "step": 1
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": false,
      "requiresWriteAccess": false
    },
    {
      "id": "plex-wait-library-scan",
      "version": "1.0.0",
      "name": "Attendre la fin du scan Plex",
      "description": "Attend la fin du scan d’une bibliothèque avant de poursuivre.",
      "kind": "action",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "Le composant a terminé son traitement."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "Le composant n’a pas pu terminer son traitement."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "sectionId",
            "type": "number",
            "label": "ID de bibliothèque",
            "required": true,
            "min": 1,
            "step": 1
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": false,
      "requiresWriteAccess": false
    },
    {
      "id": "plex-check-media-indexed",
      "version": "1.0.0",
      "name": "Vérifier le média dans Plex",
      "description": "Vérifie si Plex a indexé l’élément ciblé.",
      "kind": "condition",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "found",
          "label": "Trouvé",
          "description": "L’élément est présent dans la bibliothèque."
        },
        {
          "id": "notFound",
          "label": "Absent",
          "description": "L’élément n’est pas présent dans la bibliothèque."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "La vérification n’a pas pu aboutir."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "ratingKey",
            "type": "text",
            "label": "Identifiant Plex (ratingKey)",
            "required": true,
            "placeholder": "Ex. 12345"
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": false,
      "requiresWriteAccess": false
    }
  ]
}
