{
  "contractVersion": 1,
  "id": "mkv",
  "version": "1.0.0",
  "name": "Matroska & MKV",
  "supportedHostContractVersions": [
    1
  ],
  "components": [
    {
      "id": "mkv-remux-matroska",
      "version": "1.0.0",
      "name": "Créer ou remuxer un MKV",
      "description": "Regroupe les pistes choisies dans un conteneur Matroska sans les réencoder.",
      "kind": "action",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "L’action a terminé son traitement."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "L’action n’a pas pu terminer son traitement."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "processingMode",
            "label": "Mode de traitement",
            "type": "select",
            "defaultValue": "plan",
            "description": "Ajouter les réglages au plan, puis utiliser Exécuter le traitement ; ou réaliser une opération autonome.",
            "options": [
              {
                "value": "plan",
                "label": "Ajouter au plan"
              },
              {
                "value": "direct",
                "label": "Opération autonome"
              }
            ]
          },
          {
            "id": "trackType",
            "label": "Type de piste",
            "type": "select",
            "inline": true,
            "defaultValue": "all",
            "options": [
              {
                "value": "all",
                "label": "Tous"
              },
              {
                "value": "video",
                "label": "Vidéo"
              },
              {
                "value": "audio",
                "label": "Audio"
              },
              {
                "value": "subtitles",
                "label": "Sous-titres"
              }
            ]
          },
          {
            "id": "trackIds",
            "label": "Identifiants des pistes",
            "type": "text",
            "required": false,
            "description": "Identifiants séparés par des virgules ; vide pour toutes les pistes du type choisi."
          },
          {
            "id": "language",
            "label": "Filtrer par langue",
            "type": "text",
            "required": false,
            "description": "Facultatif, par exemple fra ou eng."
          },
          {
            "id": "title",
            "label": "Titre du conteneur",
            "type": "text",
            "required": false
          },
          {
            "id": "keepAttachments",
            "label": "Conserver les pièces jointes",
            "type": "boolean",
            "inline": true,
            "defaultValue": true
          }
        ]
      },
      "requiredTools": [
        {
          "toolId": "mkvtoolnix",
          "minimumVersion": null,
          "requiredCapabilities": []
        }
      ],
      "requiresMedia": true,
      "requiresWriteAccess": true,
      "compatiblePluginVersions": []
    },
