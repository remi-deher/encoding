    {
      "id": "base-disk-lock",
      "version": "1.5.0",
      "name": "Verrou de disque",
      "description": "Prend le verrou d’un disque déclaré (nom libre, par exemple « nas-1 »). Une seule exécution à la fois par disque ; si un autre traitement le tient, la sortie « Occupé » est suivie sans attendre ni bloquer le worker (à relier à « Reporter le traitement » ou « Attendre »). Le verrou suit le bail de l’exécution et est libéré à la fin, à l’attente, au relais ou par « Libérer le disque ».",
      "kind": "action",
      "mediaType": "general",
      "supportedFlowMediaTypes": [
        "video",
        "image",
        "music",
        "subtitles"
      ],
      "outputs": [
        {
          "id": "acquired",
          "label": "Verrou pris",
          "description": "Le disque est réservé pour cette exécution."
        },
        {
          "id": "busy",
          "label": "Occupé",
          "description": "Une autre exécution tient ce disque ; aucun verrou n’est pris."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "Le nom de disque est invalide."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "disk",
            "label": "Disque",
