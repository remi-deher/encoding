    {
      "id": "video-file-size-guard",
      "version": "1.0.0",
      "name": "Garde de réduction de taille",
      "description": "Compare la taille du fichier encodé à la taille de référence (source d'origine) et protège la bibliothèque contre les encodages grossissant inutilement le fichier.",
      "kind": "action",
      "mediaType": "general",
      "supportedFlowMediaTypes": [
        "video",
        "image",
        "music"
      ],
      "outputs": [
        {
          "id": "reduced",
          "label": "Gain suffisant",
          "description": "Le fichier a diminué d’au moins le pourcentage demandé."
        },
        {
          "id": "larger",
          "label": "Gain insuffisant",
          "description": "Le fichier encodé est plus lourd ou n'atteint pas le seuil d'économie."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "Impossible de lire la taille des fichiers."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "minReductionPercent",
            "label": "Réduction minimale (%)",
            "type": "number",
            "defaultValue": 10,
            "min": 0,
            "max": 100,
            "step": 1,
            "description": "Pourcentage minimum de réduction requis (ex: 10 pour 10% d'économie).",
            "required": true,
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "actionOnFailure",
            "label": "Action si gain insuffisant",
            "type": "select",
            "defaultValue": "branch",
            "options": [
              {
                "value": "branch",
                "label": "Emprunter la sortie alternative (Gain insuffisant)"
              },
              {
                "value": "revert",
                "label": "Restaurer le fichier original et emprunter la sortie"
              }
            ],
            "description": "Permet de restaurer la source d'origine pour ne pas publier un fichier plus gros.",
            "required": true,
            "importance": "basic",
            "section": "Paramètres"
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": true,
      "requiresWriteAccess": false,
      "compatiblePluginVersions": [
        "1.0.0"
      ]
