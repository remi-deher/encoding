            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "height",
            "label": "Hauteur (pixels)",
            "type": "number",
            "inline": true,
            "defaultValue": 360,
            "min": 1,
            "step": 1,
            "importance": "basic",
            "section": "Paramètres"
          }
        ]
      },
      "requiredTools": [
        {
          "toolId": "ffmpeg",
          "minimumVersion": null,
          "requiredCapabilities": []
        }
      ],
      "requiresMedia": true,
      "requiresWriteAccess": true,
      "compatiblePluginVersions": [
        "1.0.0"
      ]
    },
    {
      "id": "video-verify-decoding",
      "version": "1.0.0",
      "name": "Vérifier le décodage",
      "description": "Décode les pistes sélectionnées et signale les erreurs rencontrées.",
      "kind": "action",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "L’action a terminé son traitement."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "L’action n’a pas pu terminer son traitement."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "trackType",
            "label": "Type de piste",
            "type": "select",
            "inline": true,
            "defaultValue": "all",
            "options": [
              {
                "value": "all",
                "label": "Tous"
              },
              {
                "value": "video",
                "label": "Vidéo"
              },
              {
                "value": "audio",
                "label": "Audio"
              },
              {
                "value": "subtitles",
                "label": "Sous-titres"
              }
            ],
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "trackIds",
            "label": "Identifiants des pistes",
            "type": "text",
            "required": false,
            "description": "Identifiants séparés par des virgules ; vide pour toutes les pistes du type choisi.",
            "importance": "basic",
            "section": "Paramètres",
            "editor": "indices"
          },
          {
            "id": "language",
            "label": "Filtrer par langue",
            "type": "text",
            "required": false,
            "description": "Facultatif, par exemple fra ou eng.",
            "importance": "basic",
            "section": "Paramètres",
            "editor": "language"
          }
        ]
      },
      "requiredTools": [
        {
          "toolId": "ffmpeg",
          "minimumVersion": null,
          "requiredCapabilities": []
        }
      ],
      "requiresMedia": true,
      "requiresWriteAccess": false,
