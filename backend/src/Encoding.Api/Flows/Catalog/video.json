{
  "contractVersion": 1,
  "id": "video",
  "version": "1.1.0",
  "name": "Vidéo",
  "supportedHostContractVersions": [
    1
  ],
  "components": [
    {
      "id": "video-transcode",
      "version": "1.0.0",
      "name": "Encoder la vidéo",
      "description": "Encode la vidéo selon le codec et la qualité choisis.",
      "kind": "action",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "L’action a terminé son traitement."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "L’action n’a pas pu terminer son traitement."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "processingMode",
            "label": "Mode de traitement",
            "type": "select",
            "defaultValue": "plan",
            "description": "Ajouter les réglages au plan, puis utiliser Exécuter le traitement ; ou réaliser une opération autonome.",
            "options": [
              {
                "value": "plan",
                "label": "Ajouter au plan"
              },
              {
                "value": "direct",
                "label": "Opération autonome"
              }
            ],
            "importance": "advanced",
            "section": "Exécution"
          },
          {
            "id": "encodingProfile",
            "label": "Profil de qualité",
            "type": "encoding-profile",
            "description": "Les valeurs du profil sont intégrées au flow et restent stables après publication.",
            "importance": "basic",
            "section": "Profil et qualité"
          },
          {
            "id": "encoderMode",
            "label": "Sélection de l’encodeur",
            "type": "select",
            "defaultValue": "automatic",
            "options": [
              {
                "value": "automatic",
                "label": "Automatique selon le worker"
              },
              {
                "value": "specific",
                "label": "Encodeur précis"
              }
            ],
            "importance": "basic",
            "section": "Encodeur"
          },
          {
            "id": "encoderId",
            "label": "Encodeur précis",
            "type": "video-encoder",
            "visibleWhenFieldId": "encoderMode",
            "visibleWhenValue": "specific",
            "importance": "basic",
            "section": "Encodeur"
          },
          {
            "id": "videoCodec",
            "label": "Codec vidéo",
            "type": "select",
            "inline": true,
            "defaultValue": "hevc",
            "options": [
              {
                "value": "hevc",
                "label": "H.265 / HEVC"
              },
              {
                "value": "av1",
                "label": "AV1"
              },
              {
                "value": "h264",
                "label": "H.264"
              }
            ],
            "importance": "basic",
            "section": "Exécution"
          },
          {
            "id": "quality",
            "label": "Qualité héritée (sans profil)",
            "type": "number",
            "visibleWhenFieldId": "encodingProfile",
            "visibleWhenEmpty": true,
            "defaultValue": 23,
            "min": 0,
            "max": 51,
            "step": 1,
            "suggestions": [
              18,
              20,
              23,
              26,
              28
            ],
            "importance": "advanced",
            "section": "Profil et qualité"
          },
          {
            "id": "preset",
            "label": "Preset hérité (sans profil)",
            "type": "select",
            "visibleWhenFieldId": "encodingProfile",
            "visibleWhenEmpty": true,
            "defaultValue": "medium",
            "options": [
              {
                "value": "slow",
                "label": "Lent"
              },
              {
                "value": "medium",
                "label": "Moyen"
              },
              {
                "value": "fast",
                "label": "Rapide"
              }
            ],
            "importance": "advanced",
            "section": "Profil et qualité"
          },
          {
            "id": "hardwareAcceleration",
            "label": "Accélération héritée (sans profil)",
            "type": "select",
            "visibleWhenFieldId": "encodingProfile",
            "visibleWhenEmpty": true,
            "defaultValue": "cpu",
            "options": [
              {
                "value": "cpu",
                "label": "CPU"
              },
              {
                "value": "nvenc",
                "label": "NVIDIA NVENC"
              },
              {
                "value": "qsv",
                "label": "Intel Quick Sync"
              },
              {
                "value": "vaapi",
                "label": "VAAPI"
              }
            ],
            "importance": "advanced",
            "section": "Encodeur"
          },
          {
            "id": "qualityTier",
            "label": "Palier de qualité adaptatif",
            "type": "select",
            "defaultValue": "custom",
            "description": "Un palier autre que « Personnalisé » remplace la qualité du profil. La valeur effective dépend de la résolution et de l’encodeur ; elle est conservée dans l’historique de traitement.",
            "options": [
              {
                "value": "custom",
                "label": "Personnalisé (selon profil ou valeur manuelle)"
              },
              {
                "value": "transparent",
                "label": "Visuellement transparent"
              },
              {
                "value": "high",
                "label": "Haute qualité"
              },
              {
                "value": "balanced",
                "label": "Équilibré"
              },
              {
                "value": "compact",
                "label": "Compacité maximale"
              }
            ],
            "importance": "basic",
            "section": "Profil et qualité"
          },
          {
            "id": "colorDepth",
            "label": "Profondeur de couleur",
            "type": "select",
            "defaultValue": "auto",
            "description": "Active le 10 bits pour HEVC/AV1 afin d'éliminer le banding (recommandé).",
            "options": [
              {
                "value": "auto",
                "label": "Automatique (10 bits pour HEVC/AV1)"
              },
              {
                "value": "10-bit",
                "label": "10 bits (Main 10)"
              },
              {
                "value": "source",
                "label": "Identique à la source"
              },
              {
                "value": "8-bit",
                "label": "8 bits (Standard)"
              }
            ],
            "importance": "basic",
            "section": "Couleur et HDR"
          },
          {
            "id": "preserveHdr",
            "label": "Préserver les métadonnées HDR",
            "type": "boolean",
            "defaultValue": true,
            "description": "Injecte automatiquement les espaces colorimétriques BT.2020 et courbes SMPTE ST 2084 pour éviter l'image délavée.",
            "importance": "basic",
            "section": "Couleur et HDR"
          },
          {
            "id": "retryWithCpu",
            "label": "Repli sur CPU si l’encodage matériel échoue",
            "type": "boolean",
            "defaultValue": false,
            "description": "Si un encodeur matériel est sélectionné et que FFmpeg échoue, relance une fois avec le même codec sur CPU. Utilise d’abord la cible CPU du profil, puis les encodeurs CPU compatibles disponibles. Désactivez l’option pour conserver la sortie Erreur.",
            "importance": "advanced",
            "section": "Exécution"
          }
        ]
      },
      "requiredTools": [
        {
          "toolId": "ffmpeg",
          "minimumVersion": null,
          "requiredCapabilities": []
        }
      ],
      "requiresMedia": true,
      "requiresWriteAccess": true,
      "compatiblePluginVersions": [
        "1.0.0"
      ]
    },
    {
      "id": "video-resize",
      "version": "1.0.0",
      "name": "Redimensionner la vidéo",
      "description": "Réencode la vidéo aux dimensions souhaitées en conservant ses proportions.",
      "kind": "action",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "L’action a terminé son traitement."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "L’action n’a pas pu terminer son traitement."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "processingMode",
            "label": "Mode de traitement",
            "type": "select",
            "defaultValue": "plan",
            "description": "Ajouter les réglages au plan, puis utiliser Exécuter le traitement ; ou réaliser une opération autonome.",
            "options": [
              {
                "value": "plan",
                "label": "Ajouter au plan"
              },
              {
                "value": "direct",
                "label": "Opération autonome"
              }
            ],
            "importance": "advanced",
            "section": "Exécution"
          },
          {
            "id": "width",
            "label": "Largeur maximale (pixels)",
            "type": "number",
            "inline": true,
            "defaultValue": 1920,
            "min": 1,
            "step": 1,
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "height",
            "label": "Hauteur maximale (pixels)",
            "type": "number",
            "inline": true,
            "defaultValue": 1080,
            "min": 1,
            "step": 1,
            "importance": "basic",
            "section": "Paramètres"
          }
        ]
      },
      "requiredTools": [
        {
          "toolId": "ffmpeg",
          "minimumVersion": null,
          "requiredCapabilities": []
        }
      ],
      "requiresMedia": true,
      "requiresWriteAccess": true,
      "compatiblePluginVersions": [
        "1.0.0"
      ]
    },
    {
      "id": "video-auto-crop",
      "version": "1.0.0",
      "name": "Rognage automatique des bandes noires",
      "description": "Détecte les bandes noires (letterboxing/pillarboxing) par échantillonnage FFmpeg et intègre le filtre de rognage au plan d’encodage ou l’applique directement.",
      "kind": "action",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "cropped",
          "label": "Rogné",
          "description": "Bandes noires détectées et rognage configuré."
        },
        {
          "id": "no-crop",
          "label": "Plein cadre",
          "description": "Aucun rognage requis (image déjà pleine)."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "La sonde de détection a échoué."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "processingMode",
            "label": "Mode d’exécution",
            "type": "select",
            "defaultValue": "plan",
            "options": [
              {
                "value": "plan",
                "label": "Ajouter au plan (combiné au transcodage)"
              },
              {
                "value": "direct",
                "label": "Exécuter immédiatement"
              }
            ],
            "description": "Le mode plan combine le filtre de rognage à base-transcode-video sans réécriture intermédiaire.",
            "required": true,
            "importance": "advanced",
            "section": "Exécution"
          },
          {
            "id": "samplePoints",
            "label": "Points d'échantillonnage",
            "type": "number",
            "defaultValue": 5,
            "min": 1,
            "max": 20,
            "step": 1,
            "description": "Nombre de segments temporels analysés sur la vidéo.",
            "required": false,
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "threshold",
            "label": "Sensibilité cropdetect",
            "type": "number",
            "defaultValue": 24,
            "min": 1,
            "max": 100,
            "step": 1,
            "description": "Seuil de noirceur pour cropdetect (24 par défaut).",
            "required": false,
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "roundMultiple",
            "label": "Arrondi de dimension",
            "type": "number",
            "defaultValue": 2,
            "min": 2,
            "max": 32,
            "step": 2,
            "description": "Multiple auquel arrondir la largeur et la hauteur (2 ou 16).",
            "required": false,
            "importance": "basic",
            "section": "Paramètres"
          }
        ]
      },
      "requiredTools": [
        {
          "toolId": "ffmpeg",
          "minimumVersion": "6.0.0",
          "requiredCapabilities": []
        }
      ],
      "requiresMedia": true,
      "requiresWriteAccess": false,
      "compatiblePluginVersions": [
        "1.0.0"
      ]
    },
    {
      "id": "video-deinterlace",
      "version": "1.0.0",
      "name": "Désentrelacement automatique",
      "description": "Analyse les trames avec le filtre idet de FFmpeg et applique un désentrelacement bwdif ou yadif si le contenu est entrelacé.",
      "kind": "action",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "deinterlaced",
          "label": "Désentrelacé",
          "description": "Vidéo entrelacée détectée et filtre de désentrelacement appliqué ou ajouté au plan."
        },
        {
          "id": "progressive",
          "label": "Progressif",
          "description": "Vidéo déjà progressive (aucun filtre ajouté)."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "Échec de détection d'entrelacement."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "processingMode",
            "label": "Mode d’exécution",
            "type": "select",
            "defaultValue": "plan",
            "options": [
              {
                "value": "plan",
                "label": "Ajouter au plan (combiné au transcodage)"
              },
              {
                "value": "direct",
                "label": "Exécuter immédiatement"
              }
            ],
            "description": "Le mode plan applique le désentrelacement pendant l'encodage sans passe séparée.",
            "required": true,
            "importance": "advanced",
            "section": "Exécution"
          },
          {
            "id": "algorithm",
            "label": "Algorithme",
            "type": "select",
            "defaultValue": "bwdif",
            "options": [
              {
                "value": "bwdif",
                "label": "bwdif (Bob Weaver Deinterlacing - recommandé)"
              },
              {
                "value": "yadif",
                "label": "yadif (Yet Another Deinterlacing Filter)"
              }
            ],
            "description": "Filtre FFmpeg de désentrelacement.",
            "required": true,
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "detectionFrames",
            "label": "Trames analysées",
            "type": "number",
            "defaultValue": 1000,
            "min": 100,
            "max": 10000,
            "step": 100,
            "description": "Nombre de trames analysées pour la détection idet.",
            "required": false,
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "interlaceThresholdPercent",
            "label": "Seuil d'entrelacement (%)",
            "type": "number",
            "defaultValue": 10,
            "min": 1,
            "max": 100,
            "step": 1,
            "description": "Pourcentage minimum de trames entrelacées pour activer le filtre (10% par défaut).",
            "required": false,
            "importance": "basic",
            "section": "Paramètres"
          }
        ]
      },
      "requiredTools": [
        {
          "toolId": "ffmpeg",
          "minimumVersion": "6.0.0",
          "requiredCapabilities": []
        }
      ],
      "requiresMedia": true,
      "requiresWriteAccess": false,
      "compatiblePluginVersions": [
        "1.0.0"
      ]
    },
    {
      "id": "video-thumbnail",
      "version": "1.0.0",
      "name": "Créer une miniature",
      "description": "Extrait une image à la position choisie dans la vidéo.",
      "kind": "action",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "success",
