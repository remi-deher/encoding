    {
      "id": "audio-convert-by-rules",
      "version": "1.1.0",
      "name": "Convertir l’audio par règles",
      "description": "Applique la première règle correspondante à chaque piste audio. Les pistes sans règle sont conservées. Les conversions alimentent le plan FFmpeg commun ; la disposition des canaux reste vérifiée.",
      "kind": "action",
      "mediaType": "audio",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "Des pistes ont été converties ou ajoutées au plan."
        },
        {
          "id": "unchanged",
          "label": "Déjà conforme",
          "description": "Toutes les pistes respectent déjà les règles."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "Une règle ne peut pas être appliquée sans risque (disposition inconnue ou non prise en charge). Le fichier d’origine n’est pas remplacé."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "rules",
