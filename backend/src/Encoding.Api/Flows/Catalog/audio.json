{
  "contractVersion": 1,
  "id": "audio",
  "version": "1.1.0",
  "name": "Audio",
  "supportedHostContractVersions": [
    1
  ],
  "components": [
    {
      "id": "audio-transcode",
      "version": "1.0.0",
      "name": "Encoder l’audio",
      "description": "Convertit une piste audio et règle son débit et ses canaux.",
      "kind": "action",
      "mediaType": "audio",
      "supportedFlowMediaTypes": [
        "video",
        "music"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "L’action a terminé son traitement."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "L’action n’a pas pu terminer son traitement."
        },
        {
          "id": "unchanged",
          "label": "Aucune modification",
          "description": "Aucune piste correspondante ou dimensions déjà conformes : le média est conservé."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "processingMode",
            "label": "Mode de traitement",
            "type": "select",
            "defaultValue": "plan",
            "description": "Ajouter les réglages au plan, puis utiliser Exécuter le traitement ; ou réaliser une opération autonome.",
            "options": [
              {
                "value": "plan",
                "label": "Ajouter au plan"
              },
              {
                "value": "direct",
                "label": "Opération autonome"
              }
            ],
            "importance": "advanced",
            "section": "Exécution"
          },
          {
            "id": "trackSelection",
            "label": "Sélection des pistes audio",
            "type": "record-list",
            "importance": "basic",
            "section": "Paramètres",
            "itemFields": [
              {
                "id": "languages",
                "label": "Langues",
                "type": "text",
                "importance": "basic",
                "section": "Paramètres",
                "defaultValue": "",
                "description": "Codes ISO séparés par des virgules. Vide : toutes les langues."
              },
              {
                "id": "sourceCodecs",
                "label": "Codecs source",
                "type": "text",
                "importance": "advanced",
                "section": "Paramètres",
                "defaultValue": "",
                "description": "Exemple : dts,truehd. Vide : tous les codecs."
              },
              {
                "id": "minChannels",
                "label": "Canaux minimum",
                "type": "number",
                "importance": "basic",
                "section": "Paramètres",
                "min": 0,
                "max": 64,
                "defaultValue": 0
              },
              {
                "id": "maxChannels",
                "label": "Canaux maximum (0 : sans limite)",
                "type": "number",
                "importance": "basic",
                "section": "Paramètres",
                "min": 0,
                "max": 64,
                "defaultValue": 0
              },
              {
                "id": "titleContains",
                "label": "Le titre contient",
                "type": "text",
                "importance": "advanced",
                "section": "Paramètres",
                "defaultValue": ""
              },
              {
                "id": "excludeCommentary",
                "label": "Commentaires",
                "type": "select",
                "importance": "advanced",
                "section": "Paramètres",
                "options": [
                  {
                    "value": "no",
                    "label": "Inclure"
                  },
                  {
                    "value": "yes",
                    "label": "Exclure les titres contenant « comment »"
                  }
                ],
                "defaultValue": "no"
              }
            ],
            "maxItems": 1,
            "defaultValue": [],
            "description": "Sans règle : utiliser le numéro de piste. Avec une règle : appliquer à toutes les pistes correspondantes ; les autres restent copiées.",
            "requiresPluginVersion": "1.1.0"
          },
          {
            "id": "trackId",
            "label": "Position parmi les pistes audio (à partir de 0)",
            "type": "number",
            "inline": true,
            "defaultValue": 0,
            "min": 0,
            "step": 1,
            "importance": "basic",
            "section": "Paramètres",
            "visibleWhenFieldId": "trackSelection",
            "visibleWhenEmpty": true
          },
          {
            "id": "audioCodec",
            "label": "Codec audio",
            "type": "select",
            "inline": true,
            "defaultValue": "aac",
            "options": [
              {
                "value": "aac",
                "label": "AAC"
              },
              {
                "value": "opus",
                "label": "Opus"
              },
              {
                "value": "flac",
                "label": "FLAC"
              },
              {
                "value": "ac3",
                "label": "AC-3"
              }
            ],
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "bitrateKbps",
            "label": "Débit cible avec perte (kbit/s)",
            "type": "number",
            "inline": true,
            "defaultValue": 192,
            "min": 32,
            "max": 1536,
            "step": 32,
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "channels",
            "label": "Canaux",
            "type": "select",
            "inline": true,
            "defaultValue": "source",
            "options": [
              {
                "value": "source",
                "label": "Conserver"
              },
              {
                "value": "2",
                "label": "Stéréo"
              },
              {
                "value": "6",
                "label": "5.1"
              },
              {
                "value": "8",
                "label": "7.1"
              }
            ],
            "importance": "basic",
            "section": "Paramètres"
          }
        ]
      },
      "requiredTools": [
        {
          "toolId": "ffmpeg",
          "minimumVersion": null,
          "requiredCapabilities": []
        }
      ],
      "requiresMedia": true,
      "requiresWriteAccess": true,
      "compatiblePluginVersions": [
        "1.0.0"
      ],
      "producesFiles": false
    },
