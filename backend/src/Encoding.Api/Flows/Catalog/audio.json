            "step": 1,
            "importance": "basic",
            "section": "Paramètres",
            "visibleWhenFieldId": "normalizationProfile",
            "visibleWhenValue": "custom"
          },
          {
            "id": "truePeak",
            "label": "True peak maximal (dBTP)",
            "type": "number",
            "inline": true,
            "defaultValue": -1.5,
            "min": -9,
            "max": 0,
            "step": 0.1,
            "importance": "basic",
            "section": "Paramètres"
          },
          {
            "id": "normalizationProfile",
            "label": "Profil sonore",
