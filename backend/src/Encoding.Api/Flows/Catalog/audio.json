                "value": "custom",
                "label": "Personnalisé"
              },
              {
                "value": "streaming",
                "label": "Écoute courante (−16 LUFS)"
              },
              {
                "value": "broadcast",
                "label": "Diffusion (−23 LUFS)"
              },
              {
                "value": "night",
                "label": "Écoute nocturne (−18 LUFS, plage réduite)"
              }
            ],
