{
  "contractVersion": 1,
  "id": "conditions",
  "version": "1.2.0",
  "name": "Conditions",
  "supportedHostContractVersions": [1],
  "components": [
    {
      "id": "conditions-match",
      "version": "1.0.0",
      "name": "Évaluer des conditions",
      "description": "Combine des règles dans des groupes ET / OU imbriqués. Les préréglages restent entièrement modifiables. Un scan est demandé uniquement pour les critères média.",
      "kind": "condition",
      "mediaType": "general",
      "supportedFlowMediaTypes": ["video", "image", "music", "subtitles"],
      "outputs": [
        { "id": "yes", "label": "Oui", "description": "Les conditions sont satisfaites." },
        { "id": "no", "label": "Non", "description": "Les conditions ne sont pas satisfaites." },
        { "id": "error", "label": "Erreur", "description": "Une donnée nécessaire est absente ou ne permet pas la comparaison." }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          { "id": "rules", "type": "condition-tree", "label": "Conditions", "required": true, "inline": true,
            "description": "Les comparaisons textuelles ignorent la casse. Les langues utilisent les codes du média, par exemple fra. Pour les données facultatives, utilisez d'abord est renseigné / est absent." }
        ]
      },
      "requiredTools": [],
      "requiresMedia": false,
      "requiresWriteAccess": false,
      "compatiblePluginVersions": ["1.0.0", "1.1.0"]
    },
    {
      "id": "conditions-video-codec",
      "version": "1.0.0",
      "name": "Codec vidéo",
      "description": "Vérifie le codec de la première piste vidéo du média.",
      "kind": "condition",
      "mediaType": "general",
      "supportedFlowMediaTypes": ["video", "image"],
      "outputs": [
        { "id": "yes", "label": "Oui", "description": "La vidéo utilise ce codec." },
        { "id": "no", "label": "Non", "description": "La vidéo n'utilise pas ce codec." },
        { "id": "error", "label": "Erreur", "description": "Aucune piste vidéo n'est présente." }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "codec",
            "type": "select",
            "label": "Codec vidéo",
            "required": true,
            "inline": true,
            "defaultValue": "hevc",
            "options": [
              { "value": "hevc", "label": "H.265 / HEVC" },
              { "value": "h264", "label": "H.264 / AVC" },
              { "value": "av1", "label": "AV1" },
              { "value": "vp9", "label": "VP9" },
              { "value": "mpeg2video", "label": "MPEG-2" },
              { "value": "vc1", "label": "VC-1" }
            ]
          },
          {
            "id": "invert",
            "type": "boolean",
            "label": "Inverser la condition (N'est pas)",
            "required": false,
            "defaultValue": false
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": true,
      "requiresWriteAccess": false,
      "compatiblePluginVersions": ["1.1.0"]
    },
    {
      "id": "conditions-audio-codec",
      "version": "1.0.0",
      "name": "Codec audio",
      "description": "Vérifie le codec des pistes audio du média.",
      "kind": "condition",
      "mediaType": "general",
      "supportedFlowMediaTypes": ["video", "music"],
      "outputs": [
        { "id": "yes", "label": "Oui", "description": "Le codec recherché est présent." },
        { "id": "no", "label": "Non", "description": "Le codec recherché n'est pas présent." },
        { "id": "error", "label": "Erreur", "description": "Aucune piste audio n'est présente." }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "codec",
            "type": "select",
            "label": "Codec audio",
            "required": true,
            "inline": true,
            "defaultValue": "eac3",
            "options": [
              { "value": "eac3", "label": "E-AC-3 / Dolby Digital Plus" },
              { "value": "ac3", "label": "AC-3 / Dolby Digital" },
              { "value": "aac", "label": "AAC" },
              { "value": "truehd", "label": "Dolby TrueHD" },
              { "value": "dts", "label": "DTS" },
              { "value": "dtshd", "label": "DTS-HD" },
              { "value": "flac", "label": "FLAC" },
              { "value": "mp3", "label": "MP3" },
              { "value": "opus", "label": "Opus" },
              { "value": "vorbis", "label": "Vorbis" }
            ]
          },
          {
            "id": "scope",
            "type": "select",
            "label": "Application",
            "required": true,
            "defaultValue": "any",
            "options": [
              { "value": "any", "label": "Au moins une piste" },
              { "value": "first", "label": "Première piste uniquement" },
              { "value": "all", "label": "Toutes les pistes" }
            ]
          },
          {
            "id": "invert",
            "type": "boolean",
            "label": "Inverser la condition (N'est pas)",
            "required": false,
            "defaultValue": false
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": true,
      "requiresWriteAccess": false,
      "compatiblePluginVersions": ["1.1.0"]
    },
    {
      "id": "conditions-video-resolution",
      "version": "1.0.0",
      "name": "Résolution vidéo",
      "description": "Vérifie la définition d'image du flux vidéo.",
      "kind": "condition",
      "mediaType": "general",
      "supportedFlowMediaTypes": ["video", "image"],
      "outputs": [
        { "id": "yes", "label": "Oui", "description": "La résolution correspond au critère." },
        { "id": "no", "label": "Non", "description": "La résolution ne correspond pas au critère." },
        { "id": "error", "label": "Erreur", "description": "Aucune piste vidéo n'est présente." }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "resolution",
            "type": "select",
            "label": "Définition",
            "required": true,
            "inline": true,
            "defaultValue": "1080p",
            "options": [
              { "value": "4k", "label": "4K / UHD (2160p)" },
              { "value": "1080p", "label": "Full HD (1080p)" },
              { "value": "720p", "label": "HD (720p)" },
              { "value": "sd", "label": "SD (< 720p)" }
            ]
          },
          {
            "id": "operator",
            "type": "select",
            "label": "Opérateur",
            "required": true,
            "defaultValue": "gte",
            "options": [
              { "value": "gte", "label": "Au moins (≥)" },
              { "value": "eq", "label": "Exactement (=)" },
              { "value": "lte", "label": "Au plus (≤)" }
            ]
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": true,
      "requiresWriteAccess": false,
      "compatiblePluginVersions": ["1.1.0"]
    },
    {
      "id": "conditions-audio-channels",
      "version": "1.0.0",
      "name": "Canaux audio",
      "description": "Vérifie le nombre de canaux audio des pistes.",
      "kind": "condition",
      "mediaType": "general",
      "supportedFlowMediaTypes": ["video", "music"],
      "outputs": [
        { "id": "yes", "label": "Oui", "description": "Le nombre de canaux correspond." },
        { "id": "no", "label": "Non", "description": "Le nombre de canaux ne correspond pas." },
        { "id": "error", "label": "Erreur", "description": "Aucune piste audio n'est présente." }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "channels",
            "type": "select",
            "label": "Canaux audio",
            "required": true,
            "inline": true,
            "defaultValue": "6",
            "options": [
              { "value": "8", "label": "7.1 (8 canaux)" },
              { "value": "6", "label": "5.1 (6 canaux)" },
              { "value": "2", "label": "Stéréo (2 canaux)" },
              { "value": "1", "label": "Mono (1 canal)" }
            ]
          },
          {
            "id": "operator",
            "type": "select",
            "label": "Opérateur",
            "required": true,
            "defaultValue": "gte",
            "options": [
              { "value": "gte", "label": "Au moins (≥)" },
              { "value": "eq", "label": "Exactement (=)" },
              { "value": "lte", "label": "Au plus (≤)" }
            ]
          },
          {
            "id": "scope",
            "type": "select",
            "label": "Application",
            "required": true,
            "defaultValue": "first",
            "options": [
              { "value": "first", "label": "Première piste uniquement" },
              { "value": "any", "label": "Au moins une piste" }
            ]
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": true,
      "requiresWriteAccess": false,
      "compatiblePluginVersions": ["1.1.0"]
    },
    {
      "id": "conditions-audio-language",
      "version": "1.0.0",
      "name": "Langue audio",
      "description": "Vérifie si une langue spécifique est présente dans les pistes audio.",
      "kind": "condition",
      "mediaType": "general",
      "supportedFlowMediaTypes": ["video", "music"],
      "outputs": [
        { "id": "yes", "label": "Oui", "description": "La langue recherchée est présente." },
        { "id": "no", "label": "Non", "description": "La langue recherchée n'est pas présente." },
        { "id": "error", "label": "Erreur", "description": "Aucune piste audio n'est présente." }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "language",
            "type": "select",
            "label": "Langue audio",
            "required": true,
            "inline": true,
            "defaultValue": "fra",
            "options": [
              { "value": "fra", "label": "Français (fra/fre)" },
              { "value": "eng", "label": "Anglais (eng)" },
              { "value": "jpn", "label": "Japonais (jpn)" },
              { "value": "deu", "label": "Allemand (deu/ger)" },
              { "value": "spa", "label": "Espagnol (spa)" },
              { "value": "ita", "label": "Italien (ita)" },
              { "value": "por", "label": "Portugais (por)" },
              { "value": "rus", "label": "Russe (rus)" },
              { "value": "zho", "label": "Chinois (zho/chi)" },
              { "value": "kor", "label": "Coréen (kor)" },
              { "value": "und", "label": "Indéterminée (und)" }
            ]
          },
          {
            "id": "scope",
            "type": "select",
            "label": "Application",
            "required": true,
            "defaultValue": "any",
            "options": [
              { "value": "any", "label": "Au moins une piste" },
              { "value": "first", "label": "Première piste uniquement" }
            ]
          },
          {
            "id": "invert",
            "type": "boolean",
            "label": "Inverser la condition (N'est pas)",
            "required": false,
            "defaultValue": false
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": true,
      "requiresWriteAccess": false,
      "compatiblePluginVersions": ["1.1.0"]
    },
    {
      "id": "conditions-video-hdr",
      "version": "1.0.0",
      "name": "Format HDR / Dynamique",
      "description": "Vérifie si la vidéo utilise un format HDR (Dolby Vision, HDR10, HDR10+, HLG) ou SDR.",
      "kind": "condition",
      "mediaType": "general",
      "supportedFlowMediaTypes": ["video", "image"],
      "outputs": [
        { "id": "yes", "label": "Oui", "description": "Le format correspond au critère." },
        { "id": "no", "label": "Non", "description": "Le format ne correspond pas au critère." },
        { "id": "error", "label": "Erreur", "description": "Aucune piste vidéo n'est présente." }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "format",
            "type": "select",
            "label": "Format dynamique",
            "required": true,
            "inline": true,
            "defaultValue": "any-hdr",
            "options": [
              { "value": "any-hdr", "label": "Tout format HDR" },
              { "value": "dolby-vision", "label": "Dolby Vision" },
              { "value": "hdr10", "label": "HDR10" },
              { "value": "hdr10plus", "label": "HDR10+" },
              { "value": "hlg", "label": "HLG" },
              { "value": "sdr", "label": "SDR (non HDR)" }
            ]
          },
          {
            "id": "invert",
            "type": "boolean",
            "label": "Inverser la condition (N'est pas)",
            "required": false,
            "defaultValue": false
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": true,
      "requiresWriteAccess": false,
      "compatiblePluginVersions": []
    },
    {
      "id": "conditions-video-bitdepth",
      "version": "1.0.0",
      "name": "Profondeur de couleur",
      "description": "Vérifie la profondeur de couleur de la vidéo (8-bit, 10-bit, 12-bit).",
      "kind": "condition",
      "mediaType": "general",
      "supportedFlowMediaTypes": ["video", "image"],
      "outputs": [
        { "id": "yes", "label": "Oui", "description": "La profondeur correspond." },
        { "id": "no", "label": "Non", "description": "La profondeur ne correspond pas." },
        { "id": "error", "label": "Erreur", "description": "Aucune piste vidéo n'est présente." }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "depth",
            "type": "select",
            "label": "Profondeur",
            "required": true,
            "inline": true,
            "defaultValue": "10-bit",
            "options": [
              { "value": "10-bit", "label": "10 bits (Main 10)" },
              { "value": "8-bit", "label": "8 bits (Standard)" },
              { "value": "12-bit", "label": "12 bits" }
            ]
          },
          {
            "id": "invert",
            "type": "boolean",
            "label": "Inverser la condition (N'est pas)",
            "required": false,
            "defaultValue": false
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": true,
      "requiresWriteAccess": false,
      "compatiblePluginVersions": []
    }
  ]
}
