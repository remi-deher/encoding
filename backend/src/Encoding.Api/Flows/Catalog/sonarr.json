{
  "contractVersion": 1,
  "id": "sonarr",
  "version": "1.0.0",
  "name": "Sonarr",
  "supportedHostContractVersions": [
    1
  ],
  "configurationSchema": {
    "version": 1,
    "fields": [
      {
        "id": "baseUrl",
        "type": "text",
        "label": "Adresse du serveur",
        "required": true,
        "placeholder": "http://sonarr:8989"
      },
      {
        "id": "apiKey",
        "type": "secret",
        "label": "Clé API Sonarr",
        "required": true
      }
    ]
  },
  "components": [
    {
      "id": "sonarr-refresh-series",
      "version": "1.0.0",
      "name": "Actualiser une série Sonarr",
      "description": "Synchronise le statut de la série après traitement.",
      "kind": "action",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "Le composant a terminé son traitement."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "Le composant n’a pas pu terminer son traitement."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": []
      },
      "requiredTools": [],
      "requiresMedia": false,
      "requiresWriteAccess": false
    },
    {
      "id": "sonarr-check-episode-indexed",
      "version": "1.0.0",
      "name": "Vérifier l’épisode dans Sonarr",
      "description": "Vérifie si l’épisode ciblé est reconnu par Sonarr.",
      "kind": "condition",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "found",
          "label": "Trouvé",
          "description": "L’élément est présent dans la bibliothèque."
        },
        {
          "id": "notFound",
          "label": "Absent",
          "description": "L’élément n’est pas présent dans la bibliothèque."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "La vérification n’a pas pu aboutir."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "episodeId",
            "type": "number",
            "label": "ID de l’épisode Sonarr",
            "required": true,
            "min": 1,
            "step": 1
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": false,
      "requiresWriteAccess": false
    },
    {
      "id": "sonarr-search-missing-episodes",
      "version": "1.0.0",
      "name": "Rechercher les épisodes manquants",
      "description": "Demande à Sonarr de rechercher les épisodes manquants d’une série surveillée.",
      "kind": "action",
      "mediaType": "video",
      "supportedFlowMediaTypes": [
        "video"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "Le composant a terminé son traitement."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "Le composant n’a pas pu terminer son traitement."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "seriesId",
            "type": "number",
            "label": "ID de la série Sonarr",
            "required": true,
            "min": 1,
            "step": 1
          }
        ]
      },
      "requiredTools": [],
      "requiresMedia": false,
      "requiresWriteAccess": false
    }
  ]
}
