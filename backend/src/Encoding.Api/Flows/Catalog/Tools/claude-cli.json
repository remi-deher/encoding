{
  "$schema": "https://encoding.io/schemas/v1/tool.json",
  "id": "claude-cli",
  "name": "Anthropic Claude Code CLI",
  "description": "Interface en ligne de commande officielle pour Claude.",
  "category": "ai-text",
  "executable": "claude",
  "probe": {
    "versionArgs": ["--version"],
    "versionRegex": "claude(?:-code)?\\s+v?(?<version>[0-9\\.]+)",
    "smokeTestArgs": ["--help"]
  },
  "capabilitiesExposed": [
    "ai-text-generation",
    "subtitles-translation"
  ],
  "auth": {
    "type": "device-code",
    "loginCommand": ["claude", "auth", "login"],
    "statusCommand": ["claude", "auth", "status"]
  }
}
