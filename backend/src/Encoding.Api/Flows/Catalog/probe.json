      "id": "probe-media",
      "version": "1.0.0",
      "name": "Analyser le média",
      "description": "Lit les métadonnées du scan courant : conteneur, durée, taille et débit.",
      "kind": "action",
      "mediaType": "general",
      "supportedFlowMediaTypes": [
        "video",
        "image",
        "music",
        "subtitles"
      ],
      "outputs": [
        {
          "id": "success",
          "label": "Suite",
          "description": "L’action a terminé son traitement."
        },
        {
          "id": "error",
          "label": "Erreur",
          "description": "L’action n’a pas pu terminer son traitement."
        }
      ],
      "configurationSchema": {
        "version": 1,
        "fields": [
          {
            "id": "resultVariable",
            "label": "Variable de résultat",
            "type": "text",
            "required": true,
            "description": "Nom de la variable accessible aux actions et conditions suivantes.",
            "defaultValue": "mediaDetails"
          },
          {
            "id": "refreshMetadata",
            "label": "Actualiser les métadonnées",
            "type": "boolean",
            "inline": true,
            "defaultValue": false
          }
        ]
      },
      "requiredTools": [
