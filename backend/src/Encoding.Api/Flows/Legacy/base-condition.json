{
  "id": "base-condition",
  "version": "1.0.0",
  "name": "Tester une condition",
  "description": "Évalue une règle et dirige le flow selon le résultat.",
  "kind": "condition",
  "mediaType": "general",
  "supportedFlowMediaTypes": [
    "video",
    "image",
    "music",
    "subtitles"
  ],
  "outputs": [
    {
      "id": "yes",
      "label": "Oui",
      "description": "La condition est satisfaite."
    },
    {
      "id": "no",
      "label": "Non",
      "description": "La condition n’est pas satisfaite."
    },
    {
      "id": "error",
      "label": "Erreur",
      "description": "La condition n’a pas pu être évaluée."
    }
  ],
  "configurationSchema": {
    "version": 1,
    "fields": [
      {
        "id": "expression",
        "type": "text",
        "label": "Expression",
        "description": "Règle à évaluer pour choisir la sortie.",
        "placeholder": "Ex. codec vidéo = HEVC",
        "required": true,
        "multiline": true
      }
    ]
  },
  "requiredTools": [],
  "requiresMedia": false,
  "requiresWriteAccess": false,
  "compatiblePluginVersions": [
    "1.0.0",
    "1.1.0",
    "1.2.0",
    "1.3.0",
    "1.4.0",
    "1.5.0",
    "1.6.0"
  ]
}
