  "version": 1,
  "name": "HEVC \u002B AAC/AC3 \u002B ASS (Crunchyroll)",
  "mediaType": "video",
  "nodes": [
    {
      "id": "entry",
      "name": "Fichier vid\u00E9o",
      "component": {
        "pluginId": "base",
        "pluginVersion": "1.6.0",
        "componentId": "base-input-video",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {}
    },
    {
      "id": "playback",
      "name": "Lecture en cours dans Plex",
      "component": {
        "pluginId": "plex",
        "pluginVersion": "1.1.0",
        "componentId": "plex-check-playback",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {
        "scope": "file",
        "includeNextEpisode": true,
        "nextEpisodeMarginMinutes": 15
      }
    },
    {
      "id": "defer-playing",
      "name": "Reporter : lecture en cours",
      "component": {
        "pluginId": "base",
        "pluginVersion": "1.6.0",
        "componentId": "base-defer-processing",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {
        "delayMinutes": 10,
        "reason": "Lecture en cours dans Plex"
      }
    },
    {
      "id": "disk",
      "name": "Verrou de disque",
      "component": {
        "pluginId": "base",
        "pluginVersion": "1.6.0",
        "componentId": "base-disk-lock",
        "componentVersion": "1.5.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {
        "disk": "disque-1"
      }
    },
    {
      "id": "defer-disk",
      "name": "Reporter : disque occup\u00E9",
      "component": {
        "pluginId": "base",
        "pluginVersion": "1.6.0",
        "componentId": "base-defer-processing",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {
        "delayMinutes": 2,
        "reason": "Disque occup\u00E9 par un autre traitement"
      }
    },
    {
      "id": "snapshot",
      "name": "Noms de pistes d\u0027origine",
      "component": {
        "pluginId": "subtitles",
        "pluginVersion": "1.0.0",
        "componentId": "subtitles-track-names",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {
        "mode": "snapshot"
      }
    },
    {
      "id": "prepare",
      "name": "Pr\u00E9parer le plan FFmpeg",
      "component": {
        "pluginId": "base",
        "pluginVersion": "1.6.0",
        "componentId": "base-prepare-processing",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {
        "tool": "ffmpeg",
        "preserveUnchangedTracks": true
      }
    },
    {
      "id": "video",
      "name": "Vid\u00E9o HEVC",
      "component": {
        "pluginId": "video",
        "pluginVersion": "1.0.0",
        "componentId": "video-transcode",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {
        "processingMode": "plan",
        "encoderMode": "automatic",
        "videoCodec": "hevc"
      }
    },
    {
      "id": "audio",
      "name": "Audio par r\u00E8gles",
      "component": {
        "pluginId": "audio",
        "pluginVersion": "1.0.0",
        "componentId": "audio-rules",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {
        "processingMode": "plan",
        "unknownLayout": "infer"
      }
    },
    {
      "id": "execute",
      "name": "Ex\u00E9cuter le plan (une \u00E9criture)",
      "component": {
        "pluginId": "base",
        "pluginVersion": "1.6.0",
        "componentId": "base-execute-processing",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {}
    },
    {
      "id": "subtitles",
      "name": "Sous-titres ASS",
      "component": {
        "pluginId": "subtitles",
        "pluginVersion": "1.0.0",
        "componentId": "subtitles-manage",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {
        "styleProfile": "crunchyroll"
      }
    },
    {
      "id": "fonts",
      "name": "Polices",
      "component": {
        "pluginId": "subtitles",
        "pluginVersion": "1.0.0",
        "componentId": "subtitles-add-fonts",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {
        "fontSet": "Crunchyroll"
      }
    },
    {
      "id": "names",
      "name": "Noms de pistes",
      "component": {
        "pluginId": "subtitles",
        "pluginVersion": "1.0.0",
        "componentId": "subtitles-track-names",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {
        "mode": "apply",
        "singleDefaultAudio": true
      }
    },
    {
      "id": "done",
      "name": "Termin\u00E9",
      "component": {
        "pluginId": "base",
        "pluginVersion": "1.6.0",
        "componentId": "base-complete-flow",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {
        "result": "success"
      }
    },
    {
      "id": "fail",
      "name": "\u00C9chec",
      "component": {
        "pluginId": "base",
        "pluginVersion": "1.6.0",
        "componentId": "base-complete-flow",
        "componentVersion": "1.0.0",
        "configurationSchemaVersion": 1
      },
      "configuration": {
        "result": "failed",
        "message": "Une \u00E9tape du flow a \u00E9chou\u00E9 ; la source est intacte."
      }
    }
