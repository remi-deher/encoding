root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.cs]
indent_style = space
indent_size = 4
# Les règles CA de AnalysisLevel latest-recommended restent des suggestions.
# Le globalconfig du SDK (global_level -100) gagne sur une sévérité de catégorie ;
# chaque identifiant est donc repris ici. `dotnet build -warnaserror` élève
# tout avertissement compilateur : une CA laissée en warning casse la CI.
# Ne pas monter ces règles en erreur avant un commit de format dédié.
dotnet_diagnostic.IDE0055.severity = suggestion
dotnet_diagnostic.CA1000.severity = suggestion
dotnet_diagnostic.CA1001.severity = suggestion
dotnet_diagnostic.CA1010.severity = suggestion
dotnet_diagnostic.CA1016.severity = suggestion
